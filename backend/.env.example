# AgentShield Backend Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env!

# ─── Groq LLM (Optional — enabling this activates FULL mode) ───────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ─── LangSmith Observability (Optional) ──────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentshield
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ─── Server Configuration ────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Storage Configuration ───────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma
DATABASE_URL=sqlite+aiosqlite:///./data/agentshield.db

# ─── Security Controls ───────────────────────────────────────────────────────
MAX_INPUT_LENGTH=8000
REQUEST_TIMEOUT_SECONDS=30
